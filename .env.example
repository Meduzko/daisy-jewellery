# Example environment variables (copy values into .env.local; never commit real secrets).

# Redis — same machine as Next.js (see scripts/install-redis-debian.sh). Required so pending orders
# survive between /api/create-payment and LiqPay /api/payment-callback.
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL (Knex). Local development only — never put production credentials here.
# Local PostgreSQL 18 runs in Docker (compose.yaml, port 127.0.0.1:5433): `npm run db:up`.
POSTGRES_USER=daisy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=daisy_dev
DATABASE_URL=postgres://daisy:change-me@127.0.0.1:5433/daisy_dev
# Optional: separate database for `npm run db:migrate -- --env test` (created on first `db:up`)
TEST_DATABASE_URL=postgres://daisy:change-me@127.0.0.1:5433/daisy_test
# Set to true when the server requires TLS (managed PostgreSQL)
DATABASE_SSL=false
# DATABASE_POOL_MAX=10
# Pool size per `next build` worker (build runs one worker per CPU; keep workers × pool < max_connections)
# DATABASE_BUILD_POOL_MAX=2

# Product catalog source: postgres (default) | dntrade (rollback to the DNTrade API).
# PostgreSQL mode needs DATABASE_URL; DNTrade mode needs API_ROOT_URI, API_KEY and the *_CATEGORY_ID values.
CATALOG_SOURCE=postgres
# DNTrade store id added to cart items while orders are still uploaded to DNTrade (optional).
DNTRADE_STORE_ID=
# Enables POST /api/catalog/revalidate (Authorization: Bearer <secret>) to purge the catalog cache.
CATALOG_REVALIDATE_SECRET=

# Directus CMS (compose.cms.yaml, db/directus/README.md). Generate secrets: openssl rand -hex 32
# Database Directus connects to (the same PostgreSQL; a clone first — see the README).
DIRECTUS_DB_DATABASE=daisy_dev
# Password of the restricted `directus` DB role (created by db/directus/setup-db.sql).
DIRECTUS_DB_PASSWORD=
DIRECTUS_SECRET=
# First admin, created only on the first start of an empty `directus` schema. Change the password after login.
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
# Public URL of the admin panel; blog images are served from <DIRECTUS_PUBLIC_URL>/assets/<id>.
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Where `npm run cms:configure` reaches the Directus API from this machine.
DIRECTUS_URL=http://localhost:8055
# Where the Directus container calls Next.js after edits (Flow «Оновити кеш сайту»).
# DIRECTUS_REVALIDATE_URL=http://host.docker.internal:3000/api/catalog/revalidate

# Product images: dntrade (default, the stored DNTrade URLs) | r2 (Cloudflare R2 copies where
# product_images.r2_key is set; rows without a key keep the DNTrade URL). Restart + revalidate after a change.
PRODUCT_IMAGE_SOURCE=dntrade
NEXT_PUBLIC_IMAGE_BASE_URL=https://images.daisy-jewellery.com.ua
# Only for `npm run images:r2` (read-only R2 listing). Server-side only — never NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=daisy-jewellery-images
# Directus uploads → R2 (compose.cms.yaml, storage location `r2`, keys cms/<uuid>.<ext>). A separate R2 API
# token with Object Read & Write on the bucket only; used by the Directus container, never by Next.js.
DIRECTUS_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
DIRECTUS_R2_ACCESS_KEY_ID=
DIRECTUS_R2_SECRET_ACCESS_KEY=
