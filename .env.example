# Example environment variables (copy values into .env.local; never commit real secrets).

# Redis — same machine as Next.js (see scripts/install-redis-debian.sh). Required so pending orders
# survive between /api/create-payment and LiqPay /api/payment-callback.
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL (Knex). Local development only — never put production credentials here.
# Local PostgreSQL 18 runs in Docker (compose.yaml, port 127.0.0.1:5433): `npm run db:up`.
POSTGRES_USER=daisy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=daisy_dev
DATABASE_URL=postgres://daisy:change-me@127.0.0.1:5433/daisy_dev
# Optional: separate database for `npm run db:migrate -- --env test` (created on first `db:up`)
TEST_DATABASE_URL=postgres://daisy:change-me@127.0.0.1:5433/daisy_test
# Set to true when the server requires TLS (managed PostgreSQL)
DATABASE_SSL=false
# DATABASE_POOL_MAX=10
# Pool size per `next build` worker (build runs one worker per CPU; keep workers × pool < max_connections)
# DATABASE_BUILD_POOL_MAX=2

# Product catalog source: postgres (default) | dntrade (rollback to the DNTrade API).
# PostgreSQL mode needs DATABASE_URL; DNTrade mode needs API_ROOT_URI, API_KEY and the *_CATEGORY_ID values.
CATALOG_SOURCE=postgres
# DNTrade store id added to cart items while orders are still uploaded to DNTrade (optional).
DNTRADE_STORE_ID=
# Enables POST /api/catalog/revalidate (Authorization: Bearer <secret>) to purge the catalog cache.
CATALOG_REVALIDATE_SECRET=
