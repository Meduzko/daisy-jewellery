{
  "name": "daisy-jewellery-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:status": "knex migrate:status",
    "db:make": "knex migrate:make -x js",
    "db:import:products": "node db/import/import-products.js",
    "db:import:dntrade": "node db/import/import-dntrade-api.js",
    "db:import:ru": "node db/import/import-ru-translations.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@emotion/cache": "^11.13.1",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/material-nextjs": "^7.3.10",
    "@sentry/nextjs": "^10.40.0",
    "cheerio": "^1.0.0",
    "crypto-js": "^4.2.0",
    "googleapis": "^144.0.0",
    "html-entities": "^2.5.2",
    "ioredis": "^5.4.1",
    "knex": "^3.1.0",
    "next": "16.4.5",
    "nodemailer": "^8.0.1",
    "pg": "^8.13.1",
    "rate-limiter-flexible": "^5.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-input-mask": "^2.0.4",
    "sharp": "^0.33.5",
    "swiper": "^12.1.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "sass": "^1.77.8"
  }
}
